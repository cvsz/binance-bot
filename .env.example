# คัดลอกเป็น .env (อย่า commit ไฟล์ .env)
# Testnet keys: https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Real keys: เปิดเฉพาะสิทธิ์ Spot Trading, ปิด Withdrawals, ผูก IP whitelist
BINANCE_API_KEY=
BINANCE_API_SECRET=
# หมายเหตุ: BINANCE_API_SECRET รับได้ 2 แบบ
#   1) System generated (HMAC): ใส่ secret ที่ Binance ออกให้เป็นบรรทัดเดียว (ด้านบน)
#   2) Self-generated (Ed25519/RSA): ใส่ PEM private key แบบมีขึ้นบรรทัดจริงในเครื่องหมายคำพูด
#      ตัวอย่าง (KEY FAKE — อย่า copy มาใช้จริง):
# BINANCE_API_SECRET="-----BEGIN PRIVATE KEY-----
# MC4CAQAwBQYDK2VwBCIEIFakeFakeFakeFakeFakeFake
# -----END PRIVATE KEY-----"
#      สร้างด้วย https://github.com/binance/asymmetric-key-generator/releases (เลือก Ed25519,
#      อย่าใส่ passphrase เพราะ ccxt ไม่ถอดรหัส PEM ที่ encrypt) แล้วอัปโหลด public key ให้ Binance

# Binance.US (exchange.name: binanceus) — ใช้แทนชุด BINANCE_* ด้านบน
BINANCEUS_TESTNET_API_KEY=
BINANCEUS_TESTNET_API_SECRET=
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=

# ต้องตั้งค่านี้ + ใช้ --real-money ถึงจะเทรดเงินจริงได้
# BOT_CONFIRM_REAL_MONEY=YES_I_ACCEPT_THE_RISK

# แจ้งเตือนผ่าน Telegram (ไม่บังคับ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard: จำเป็นเมื่อเปิดให้เข้าจากนอกเครื่อง (เช่น Docker, VPS) — ใช้ค่าสุ่มยาวๆ
DASHBOARD_TOKEN=
